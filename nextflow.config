// nextflow.config — Linear Modelling pipeline

params {
    // ---- Input / Output ----
    feature_table        = "${projectDir}/data/feature_table.biom"
    meta_table           = "${projectDir}/data/meta_table.csv"
    taxonomy_table       = ""
    input_format         = "biom"                 // biom | tsv | gtdb
    output_dir           = "${projectDir}/results"

    // ---- Sample filtering ----
    min_library_size     = 5000
    exclude_column       = ""
    exclude_values       = ""

    // ---- Grouping ----
    groups_column        = ""
    groups_paste_columns = ""

    // ---- Run label ----
    label                = "analysis"

    // ---- CODA-GLMNET options ----
    coda_taxon_rank          = "Feature"
    coda_normalisation        = "TSS+CLR"          // logrelative | TSS+ILR | TSS+CLR
    coda_occupancy            = 1
    coda_top_n                = 100
    coda_lambda               = "lambda.min"       // lambda.min | lambda.1se
    coda_alpha                = 1.0                // 0=ridge, 1=lasso, 0.5=elastic net
    coda_groups_paste_columns = ""
    coda_binary_outcome       = false
    environmental_covariates  = ""                 // REQUIRED: comma-sep metadata columns
    covariates_global         = false

    // ---- Subset regression options ----
    dependent_csv          = ""                    // path to CSV (leave empty to use metadata)
    dependent_variable     = "Shannon"             // column in dependent_csv or meta_table
    dependent_source       = "csv"                 // csv | metadata
    explanatory_variables  = ""                    // REQUIRED: comma-sep metadata columns
    regression_method      = "forward"             // exhaustive | backward | forward | seqrep
    test_method            = "cv"                  // cv | aic | bic
    cv_folds               = 5
    scale_predictors       = true
    really_big             = false

    // ---- Output options ----
    merge_parquet          = false
}

// ---- Default: conda --------------------------------------------------------
conda.enabled  = true
docker.enabled = false

// ---- Process defaults ------------------------------------------------------
process {
    conda  = "${projectDir}/environment.yml"
    memory = '8 GB'
    cpus   = 2
    time   = '2h'

    withName: 'CODA_GLMNET' {
        memory = '16 GB'
        cpus   = 4
    }
    withName: 'SUBSET_REGRESSION' {
        memory = '4 GB'
        cpus   = 2
    }
    withName: 'SUBSET_REGRESSION_FROM_META' {
        memory = '4 GB'
        cpus   = 2
    }
}

// ---- Profiles --------------------------------------------------------------
profiles {
    conda {
        conda.enabled  = true
        docker.enabled = false
    }
    docker {
        conda.enabled     = false
        docker.enabled    = true
        docker.runOptions = "-u \$(id -u):\$(id -g) -v ${projectDir}:${projectDir}:ro"
        process {
            container = 'reubenduncan/ecologyflow-lm:latest'
        }
    }
    singularity {
        conda.enabled          = false
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            container = 'docker://reubenduncan/ecologyflow-lm:latest'
        }
    }
    standard {
        process.executor = 'local'
    }
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'general'
        process.clusterOptions = '--account=myproject'
    }
    test {
        params {
            feature_table            = "${projectDir}/test/data/feature_table.biom"
            meta_table               = "${projectDir}/test/data/meta_table.csv"
            environmental_covariates = "pH"
            explanatory_variables    = "pH,Temperature"
            dependent_variable       = "Shannon"
            dependent_source         = "metadata"
            label                    = "test_run"
        }
    }
}

// ---- Reporting -------------------------------------------------------------
report {
    enabled = true
    file    = "${params.output_dir}/pipeline_report.html"
}
timeline {
    enabled = true
    file    = "${params.output_dir}/pipeline_timeline.html"
}
trace {
    enabled = true
    file    = "${params.output_dir}/pipeline_trace.txt"
}
